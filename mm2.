local aimbotActive = false

UserInputService.InputBegan:Connect(function(i, gpe)
    if gpe then return end
    if i.KeyCode == CFG.AIMBOT.key then aimbotActive = true end
end)
UserInputService.InputEnded:Connect(function(i)
    if i.KeyCode == CFG.AIMBOT.key then aimbotActive = false end
end)

local function getMurdererTarget()
    local closest, closestDist = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        if getRole(p) ~= "murderer" then continue end
        local char = p.Character
        local bone = char and char:FindFirstChild(CFG.AIMBOT.bone)
        if not bone then continue end
        local d = (Camera.CFrame.Position - bone.Position).Magnitude
        if d < closestDist then closestDist = d; closest = bone end
    end
    return closest
end

