-- ============================================================
--  ROLE DETECTION
-- ============================================================

local function getRole(player)
    local cs = game:GetService("CollectionService")
    if cs:HasTag(player, "Murderer") then return "murderer" end
    if cs:HasTag(player, "Sheriff")  then return "sheriff"  end
    -- fallback: scan tools in character
    local char = player.Character
    if char then
        for _, tool in ipairs(char:GetChildren()) do
            if tool:IsA("Tool") then
                local name = tool.Name:lower()
                if name:find("knife") or name:find("murder") then return "murderer" end
                if name:find("gun")   or name:find("sheriff") then return "sheriff"  end
            end
        end
    end
    return "innocent"
end

-- ============================================================
--  ESP — Drawing API, no distance cap, always on top
-- ============================================================

local espObjects = {}

local function newDraw(type_, props)
    local d = Drawing.new(type_)
    for k, v in pairs(props) do d[k] = v end
    return d
end

local function buildESP(player)
    if player == LocalPlayer then return end
    local obj = {}

    -- box outline (black border for visibility)
    obj.boxOut = newDraw("Square", { Visible=false, Filled=false, Color=Color3.new(0,0,0), Thickness=3, ZIndex=1 })
    obj.box    = newDraw("Square", { Visible=false, Filled=false, Color=Color3.new(1,1,1), Thickness=1.5, ZIndex=2 })

    -- tracer
    obj.tracerOut = newDraw("Line", { Visible=false, Color=Color3.new(0,0,0), Thickness=3, ZIndex=1 })
    obj.tracer    = newDraw("Line", { Visible=false, Color=Color3.new(1,1,1), Thickness=1.5, ZIndex=2 })

    -- name + role label
    obj.label = newDraw("Text", {
        Visible=false, Center=true, Outline=true,
        Size=15, Font=2,
        Color=Color3.new(1,1,1),
        Text=""
    })

    -- distance label
    obj.distLabel = newDraw("Text", {
        Visible=false, Center=true, Outline=true,
        Size=12, Font=2,
        Color=Color3.fromRGB(200,200,200),
        Text=""
    })

    espObjects[player] = obj
end

local function removeESP(player)
    local obj = espObjects[player]
    if not obj then return end
    for _, d in pairs(obj) do d:Remove() end
    espObjects[player] = nil
end

local function updateESP()
    for player, obj in pairs(espObjects) do
        if not CFG.ESP.enabled then
            for _, d in pairs(obj) do d.Visible = false end
            continue
        end

        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local head = char and char:FindFirstChild("Head")
        local hum  = char and char:FindFirstChildOfClass("Humanoid")

        -- hide if dead or no char
        if not root or not head or not hum or hum.Health <= 0 then
            for _, d in pairs(obj) do d.Visible = false end
            continue
        end

        local role = getRole(player)
        local col  = CFG.ESP[role].color
        local dist = math.floor((Camera.CFrame.Position - root.Position).Magnitude)

        -- project points — use WorldToViewportPoint
        -- *the screen peels open, every player bleeds their color*
        local headVP, headVis = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.6, 0))
        local feetVP, _       = Camera:WorldToViewportPoint(root.Position - Vector3.new(0, 2.8, 0))
        local rootVP, rootVis = Camera:WorldToViewportPoint(root.Position)

        -- even if behind camera, keep tracers pointing direction
        -- box only when on screen
        local onScreen = headVis and rootVP.Z > 0

        -- BOX
        if CFG.ESP.box then
            if onScreen then
                local boxH = math.abs(headVP.Y - feetVP.Y)
                local boxW = math.max(boxH * 0.45, 20) -- min width so tiny targets still show
                local boxX = headVP.X - boxW * 0.5
                local boxY = headVP.Y

                obj.boxOut.Size     = Vector2.new(boxW, boxH)
                obj.boxOut.Position = Vector2.new(boxX, boxY)
                obj.boxOut.Visible  = true

                obj.box.Color    = col
                obj.box.Size     = Vector2.new(boxW, boxH)
                obj.box.Position = Vector2.new(boxX, boxY)
                obj.box.Visible  = true
            else
                obj.boxOut.Visible = false
                obj.box.Visible    = false
            end
        end

        -- TRACER — always visible even off screen (points toward player)
        if CFG.ESP.tracers then
            local screenBottom = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
            local targetPoint  = Vector2.new(rootVP.X, rootVP.Y)

            -- if behind camera, flip the point so tracer points toward edge
            if rootVP.Z < 0 then
                targetPoint = Vector2.new(
                    Camera.ViewportSize.X - rootVP.X,
                    Camera.ViewportSize.Y - rootVP.Y
                )
            end

            obj.tracerOut.From    = screenBottom
            obj.tracerOut.To      = targetPoint
            obj.tracerOut.Visible = CFG.ESP.tracers
            obj.tracerOut.Color   = Color3.new(0,0,0)

            obj.tracer.Color   = col
            obj.tracer.From    = screenBottom
            obj.tracer.To      = targetPoint
            obj.tracer.Visible = CFG.ESP.tracers
        end

        -- NAME LABEL
        if CFG.ESP.names and onScreen then
            obj.label.Text     = "[" .. CFG.ESP[role].label .. "] " .. player.Name
            obj.label.Color    = col
            obj.label.Position = Vector2.new(headVP.X, headVP.Y - 20)
            obj.label.Visible  = true
        else
            obj.label.Visible = false
        end

        -- DISTANCE LABEL
        if CFG.ESP.distance and onScreen then
            obj.distLabel.Text     = dist .. "m"
            obj.distLabel.Color    = Color3.fromRGB(200, 200, 200)
            obj.distLabel.Position = Vector2.new(headVP.X, headVP.Y - 6)
            obj.distLabel.Visible  = true
        else
            obj.distLabel.Visible = false
        end
    end
end

for _, p in ipairs(Players:GetPlayers()) do buildESP(p) end
Players.PlayerAdded:Connect(buildESP)
Players.PlayerRemoving:Connect(removeESP)

